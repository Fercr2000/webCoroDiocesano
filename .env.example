# Copia este archivo como .env.local (en local) o añade estas variables en
# Vercel → Settings → Environment Variables. Ninguna es obligatoria para que
# la web arranque: sin ellas funciona con los datos de prueba.

# --- Supabase (Settings → API del proyecto) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO en el servidor, nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Envío de los formularios por email (resend.com) ---
RESEND_API_KEY=
# A quién llegan los formularios (por defecto, el email del coro)
CORREO_DESTINO=corodiocesano@diocesisdejaen.es
# Remitente: con dominio verificado en Resend; para pruebas vale onboarding@resend.dev
CORREO_REMITENTE=Coro de la Diócesis de Jaén <onboarding@resend.dev>

# --- Aviso periódico a Supabase para que no se pause (cron de Vercel) ---
CRON_SECRET=

# --- Protección temporal de toda la web con contraseña (proxy.ts) ---
ACCESO_USUARIO=
ACCESO_CLAVE=
